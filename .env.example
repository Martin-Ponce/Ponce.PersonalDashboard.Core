# Copy to .env (git-ignored, never commit it) and fill in. Read by docker-compose.yml.

# Password of the SQL Server container's "sa" login. Required. SQL Server's rules: at least 8 characters
# with upper case, lower case, a digit and a symbol. Avoid ; and quotes: it goes inside a connection string.
# It's only set when the database volume is first created; changing it later needs `docker compose down -v`.
MSSQL_SA_PASSWORD=

# Optional overrides (defaults shown).
# API_PORT=5010
# AUTH_AUTHORITY=http://localhost:5008/
# AUTH_INTERNAL_AUTHORITY=http://host.docker.internal:5008/
# AUTH_REQUIRE_HTTPS_METADATA=false
# CORS_ORIGINS=http://localhost:4200,http://localhost:8080
