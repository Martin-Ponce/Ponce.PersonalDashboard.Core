{
  "AllowedHosts": "*",
  "DatabaseConnections": {
    "Database": {
      "ConnectionString": "",
      "Provider": "SqlServer"
    }
  },
  "Logger": {
    "LogHttpRequests": false,
    "Database": {
      "Enabled": false,
      "MinimumLevel": "Error"
    }
  },
  "Telemetry": {
    "Enabled": false,
    "TracesDestination": "http://localhost:4318/v1/traces",
    "LogsDestination": "http://localhost:3100",
    "LogsMinimumLevel": "Error"
  },
  "MaxCallsPerMinute": 100,
  "Cache": {
    "Enabled": false,
    "SlidingExpirationInMinutes": 15,
    "AbsoluteExpirationInMinutes": 60
  },
  "Cors": {
    "Origins": [
      "http://localhost:4200",
      "http://localhost:8080"
    ],
    "Headers": [
      "X-Pagination"
    ]
  },
  "Authentication": {
    "Authority": "http://localhost:5008/",
    "RequireHttpsMetadata": true
  }
}
